rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.uid in ['o4iFCAvx0AdnYtoZW3FTW5OfBry1', 'zlyEN4AzIgghqOZa1l4ermZJHGd2'];
    }
    // Only the authenticated owner can access personal library preferences.
    match /users/{uid}/private/preferences {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['favorites','recent','updatedAt'])
        && request.resource.data.favorites is list
        && request.resource.data.favorites.size() <= 1000
        && request.resource.data.recent is list
        && request.resource.data.recent.size() <= 3
        && request.resource.data.updatedAt == request.time;
    }
    // Signed-in user's own profile (occupation etc.); owner only.
    match /users/{uid}/private/profile {
      allow read: if (request.auth != null && request.auth.uid == uid) || isAdmin();
      allow delete: if (request.auth != null && request.auth.uid == uid) || isAdmin();
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName','occupation','organization','province','phone','updatedAt'])
        && request.resource.data.displayName is string && request.resource.data.displayName.size() <= 60
        && request.resource.data.occupation in ['student','doctor','pharmacist','herbalist','researcher','teacher','farmer','other']
        && request.resource.data.organization is string && request.resource.data.organization.size() <= 80
        && request.resource.data.province is string && request.resource.data.province.size() <= 40
        && request.resource.data.phone is string && request.resource.data.phone.matches('^[+0-9 ()-]{0,20}$')
        && request.resource.data.updatedAt == request.time;
    }
    // ادمین کولی شي د ټولو کارونکو private ډاټا (پروفایل، خوښ شوي) ولولي (د «کارونکي» ټیب لپاره)
    match /{path=**}/private/{doc} {
      allow read: if isAdmin();
    }
    // بوټي: کارکوونکي فهرست/بیاکتل/تایید سوي لولي (مسوده نه)، ادمین ټول لولي او لیکي
    match /herbs/{id} {
      allow read: if isAdmin() || resource.data.status in ['index', 'reviewed', 'approved'];
      allow write: if isAdmin();
      match /images/{img} { allow read: if true; allow write: if isAdmin(); }
      match /history/{h}  { allow read, write: if isAdmin(); }
    }
    // د افغانستان طبي بوټي (ډیشبورډ یې اداره کوي): ټول لولي، یوازې ادمین لیکي
    match /afghan_plants/{id} {
      allow read: if true;
      allow write: if isAdmin();
      match /photos/{n} { allow read: if true; allow write: if isAdmin(); }
    }
    // د ایپ کارکوونکو نظرونه: هر څوک کولی شي نوی نظر ولېږي (محدود اندازه)، یوازې ادمین لولي او اداره کوي
    match /suggestions/{id} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid','herbId','type','text','name','lang','ts','status','createdAt','photo'])
        && request.resource.data.status == 'new'
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.herbId is string && request.resource.data.herbId.size() <= 20
        && (!('photo' in request.resource.data) || (request.resource.data.photo is string
            && request.resource.data.photo.size() <= 900000
            && request.resource.data.photo[0:15] == 'data:image/jpeg'));
      allow read, update, delete: if isAdmin();
    }
    // Compatibility: existing Android clients still submit general feedback.
    match /feedback/{id} {
      allow create: if request.resource.data.keys().hasOnly(['herbId','type','text','name','lang','ts','status','createdAt','photo'])
        && request.resource.data.status == 'new'
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.herbId is string && request.resource.data.herbId.size() <= 20
        && (!('photo' in request.resource.data) || (request.resource.data.photo is string
            && request.resource.data.photo.size() <= 900000
            && request.resource.data.photo[0:15] == 'data:image/jpeg'));
      allow read, update, delete: if isAdmin();
    }
  }
}
